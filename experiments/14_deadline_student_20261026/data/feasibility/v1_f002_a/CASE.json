    {
      "question_id": "k02",
      "question": "A station has no cases physically available, five unfilled customer cases, and eight earlier requested cases arriving later. Which statement correctly distinguishes these quantities?",
      "choices": {
        "A": "All eight requested cases are physically available now.",
        "B": "Only the five customer cases are outstanding replenishment.",
        "C": "The eight later-arriving cases erase the current unfilled customer cases immediately.",
