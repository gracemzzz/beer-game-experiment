r, which can differ from final customer purchases. Changes in these requests can propagate through successive businesses and interact with delivery delays. Shared information helps participants distinguish current physical stock, customer obligations, and previously requested replenishment. This reading explains relationships; it does not prescribe an ordering rule.","opportunity":"initial committed","completed_conditions":2,"decision":{"phase":"initial","role_order":["r","w","d","f"],"profiles":["Organized and emotionally steady in ordinary coursework.","Organized and concerned by uncertainty in ordinary coursework.","Flexible and emotionally steady in ordinary coursework.","Flexible and concerned by uncertainty in ordinary coursework."],"page_index":1,"pages":2,"requested_ids":["c001","c002","c003","c004","c005","c006","c007","c008","c009","c010","c011","c012","c013","c014","c015","c016","c017","c018","c019","c020","c021","c022","c023","c024","c025"],"week":1,"state_columns":["inventory","backlog","supply_line","demand","received","shipped"],"chain_columns":["chain_id","profile_ids","state_r_w_d_f","shared_inventory_r_w_d_f","recent_history"],"history_columns":["week","final_orders_r_w_d_f","customer_demand"],"chains":[["c001",[3,2,1,0],[[8,0,8,8,4,8],[12,0,8,4,4,4],[12,0,8,4,4,4],[12,0,8,4,4,4]],[8,12,12,12],[]],["c002",[1,2,3,0],[[15,0,8,1,4,1],[12,0,8,4,4,4],[12,0,8,4,4,4],[12,0,8,4,4,4]],[15,12,12,12],[]],["c003",[2,0,3,1],[[8,0,8,8,4,8],[12,0,8,4,4,4],[12,0,8,4,4,4],[12,0,8,4,4,4]],[8,12,12,12],[]],["c004",[1,3,2,0],[[15,0,8,1,4,1],[12,0,8,4,4,4],[12,0,8,4,4,4],[12,0,8,4,4,4]],[15,12,12,12],[]],["c005",[2,1,3,0],[[11,0,8,5,4,5],[12,0,8,4,4,4],[12,0,8,4,4,4],[12,0,8,4,4,4]],[11,12,12,12],[]],["c006",[2,3,0,1],[[8,0,8,8,4,8],[12,0,8,4,4,4],[12,0,8,4,4,4],[12,0,8,4,4,4]],[8,12,12,12],[]],["c007",[2,0,1,3],[[13,0,8,3,4,3],[12,0,8,4,4,4],[12,0,8,4,4,4],[12,0,8,4,4,4]],[13,12,12,12],[]],["c008",[3,2,0,1],[[11,0,8,5,4,5],[12,0,8,4,4,4],[12,0,8,4,4,4],[12,0,8,4,4,4]]